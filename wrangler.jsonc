{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umassproduct-website",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.js",

  // The site is a static Vite build (dist/). The Worker only runs for the
  // couple of paths it actually needs to handle in code (the CMS OAuth
  // flow) — everything else is served straight from static assets with no
  // Worker invocation at all, "not_found_handling" gives client-side
  // routing (react-router) a working SPA fallback.
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oauth/*", "/auth", "/callback"]
  }
}
